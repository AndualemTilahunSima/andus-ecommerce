{
  "name": "customer-service",
  "version": "1.0.0",
  "description": "Customer microservice with clean architecture",
  "main": "src/server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon src/server.js",
    "staging": "cross-env NODE_ENV=staging node src/server.js",
    "prod": "cross-env NODE_ENV=production node src/server.js",
    "migrate": "docker compose run --rm flyway",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "db:reset": "sequelize-cli db:drop && sequelize-cli db:create && sequelize-cli db:migrate && sequelize-cli db:seed:all",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "keywords": ["microservice", "clean-architecture", "nodejs", "express"],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "path": "^0.12.7",
    "winston": "^3.17.0",
    "zod": "^3.23.8",
    "helmet": "^8.0.0",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.4.1",
    "sequelize": "^6.37.1",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^9.34.0",
    "nodemon": "^3.1.10",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.12",
    "supertest": "^7.0.0",
    "sequelize-cli": "^6.6.2"
  }
}
